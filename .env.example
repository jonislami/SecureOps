# ---------------------------------------------------------------------------
# Sentinel — environment variable template
# Copy to .env(.local) in the relevant app. NEVER commit real secrets.
# ---------------------------------------------------------------------------

# --- Supabase (shared) ---
# Public — safe to expose to clients:
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only — NEVER ship to client bundles (Edge Functions / server actions):
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_DB_URL=postgresql://postgres:password@db.YOUR-PROJECT.supabase.co:5432/postgres

# --- Mapbox ---
NEXT_PUBLIC_MAPBOX_TOKEN=pk.your-mapbox-token
EXPO_PUBLIC_MAPBOX_TOKEN=pk.your-mapbox-token

# --- Push notifications ---
EXPO_PUBLIC_PROJECT_ID=your-eas-project-id
FCM_SERVER_KEY=your-fcm-server-key

# --- Monitoring ---
NEXT_PUBLIC_SENTRY_DSN=
EXPO_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=

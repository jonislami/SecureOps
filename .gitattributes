# Normalize line endings: LF in the repo, auto-converted on checkout.
* text=auto eol=lf

# Always LF (scripts / configs that break with CRLF)
*.sh    text eol=lf
*.sql   text eol=lf
*.ts    text eol=lf
*.tsx   text eol=lf
*.js    text eol=lf
*.json  text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf

# Binary assets — never touch
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.pdf   binary
*.keystore binary
